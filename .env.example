# Root-level secrets for the scheduled task (new architecture).
# Copy this file to .env (already gitignored) and fill in real values yourself —
# never paste real keys into chat.

# Finnhub free tier API key — https://finnhub.io/dashboard
FINNHUB_API_KEY=

# X API bearer token (pay-per-use developer app) — https://developer.x.com
X_API_BEARER_TOKEN=

# GitHub personal access token with repo scope, used by the scheduled task
# to push updated data.json to the public Pages repo
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo-name
